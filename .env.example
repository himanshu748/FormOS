# --- FormOS environment ---------------------------------------------------
# Copy this file to ".env" at the repo root and adjust.

# Connection string used by the running app (packages/db client).
#
# Local Docker Postgres (default):
DATABASE_URL="postgresql://formos:formos@localhost:5432/formos"
#
# Supabase (serverless / Vercel): use the POOLED "Transaction" connection
# string (port 6543) here. Example shape:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Connection string used ONLY for running migrations (drizzle-kit). Migrations
# need a direct/session connection. Leave unset for local Docker (falls back to
# DATABASE_URL). On Supabase set this to the DIRECT connection (port 5432):
# DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public base URL of the web app. Used to build shareable public links and the
# QR code for published forms. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin passcode that gates the builder + analytics (the management tRPC
# procedures). Public form-filling does NOT require it. Use a strong value in
# production. If this is unset, the admin area is locked (fail-closed).
ADMIN_TOKEN="change-me-in-local-dev"
