{
  "name": "formos",
  "version": "0.1.0",
  "private": true,
  "description": "FormOS — a retro-OS form builder. Turborepo + Next.js + tRPC + Drizzle + PostgreSQL.",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm --filter @formos/web start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "pnpm --filter @formos/db db:generate",
    "db:migrate": "pnpm --filter @formos/db db:migrate",
    "db:push": "pnpm --filter @formos/db db:push",
    "db:seed": "pnpm --filter @formos/db db:seed",
    "db:studio": "pnpm --filter @formos/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
